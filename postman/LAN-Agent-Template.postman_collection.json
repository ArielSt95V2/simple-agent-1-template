{
  "info": {
    "_postman_id": "c3d4e5f6-a7b8-9012-cdef-123456789012",
    "name": "LAN Agent Template",
    "description": "Full API smoke tests for the LangGraph LAN agent (health, config, ingest, chat, HITL resume, artifacts).\n\nImport with environment **LAN Agent — Local** or **LAN Agent — LAN host**.\n\nRun folder **0 — Smoke (run in order)** first.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "threadId",
      "value": "postman-test-1"
    },
    {
      "key": "artifactName",
      "value": "summary.html"
    }
  ],
  "item": [
    {
      "name": "0 — Smoke (run in order)",
      "item": [
        {
          "name": "1 Health",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has status field', () => pm.expect(j).to.have.property('status'));",
                  "pm.test('Runtime is true', () => pm.expect(j.runtime).to.eql(true));",
                  "if (j.profile) {",
                  "  pm.environment.set('agentProfile', j.profile);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "2 API Config",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('runtime_ready', () => pm.expect(j.runtime_ready).to.eql(true));",
                  "pm.test('profile present', () => pm.expect(j.profile).to.be.a('string'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/config"
          }
        },
        {
          "name": "3 Ingest scan",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('ingest result object', () => pm.expect(j).to.have.property('ingested_files'));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/ingest"
          }
        },
        {
          "name": "4 Chat — summarize documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Has reply', () => pm.expect(j.reply).to.be.a('string'));",
                  "pm.test('Has thread_id', () => pm.expect(j.thread_id).to.be.a('string'));",
                  "pm.environment.set('threadId', j.thread_id);",
                  "if (j.artifact_url) {",
                  "  const name = j.artifact_url.split('/').pop();",
                  "  pm.environment.set('artifactName', name);",
                  "}",
                  "if (j.status === 'interrupt') {",
                  "  pm.collectionVariables.set('lastInterrupt', 'true');",
                  "} else {",
                  "  pm.collectionVariables.set('lastInterrupt', 'false');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Run ingest_scan if needed, then summarize the ingested documents in a few bullet points.\",\n  \"thread_id\": \"{{threadId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        },
        {
          "name": "5 List artifacts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('artifacts array', () => pm.expect(j.artifacts).to.be.an('array'));",
                  "if (j.artifacts.length > 0) {",
                  "  pm.environment.set('artifactName', j.artifacts[j.artifacts.length - 1]);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/artifacts"
          }
        }
      ]
    },
    {
      "name": "Health & Config",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        },
        {
          "name": "API Config",
          "request": {
            "method": "GET",
