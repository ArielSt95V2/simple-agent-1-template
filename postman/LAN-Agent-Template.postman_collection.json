              "raw": "{\n  \"thread_id\": \"{{threadId}}\",\n  \"approved\": true\n}"
            },
            "url": "{{baseUrl}}/api/chat/resume"
          }
        },
        {
          "name": "Resume — Reject artifact",
          "request": {
            "method": "POST",
            "header": [
