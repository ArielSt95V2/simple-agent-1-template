      ]
    },
    {
      "name": "Artifacts",
      "item": [
        {
          "name": "List artifacts",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/artifacts"
          }
        },
        {
          "name": "Get artifact by name",
          "request": {
            "method": "GET",
