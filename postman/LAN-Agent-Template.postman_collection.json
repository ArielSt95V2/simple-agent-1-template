    {
      "name": "Ingest",
      "item": [
        {
          "name": "POST Ingest",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/api/ingest"
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Chat — RAG question",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('threadId', j.thread_id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"What files are in the ingest folder? Use list_files if helpful.\",\n  \"thread_id\": \"{{threadId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        },
        {
          "name": "Chat — request HTML dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.environment.set('threadId', j.thread_id);",
                  "  if (j.artifact_url) {",
                  "    pm.environment.set('artifactName', j.artifact_url.split('/').pop());",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Create a simple HTML dashboard with a Chart.js bar chart summarizing key themes from the documents. Use write_html_artifact.\",\n  \"thread_id\": \"{{threadId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        },
        {
          "name": "Chat — run workspace script",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Run the script scripts/example_transform.py with run_script and report the output.\",\n  \"thread_id\": \"{{threadId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        },
        {
          "name": "Chat — new thread (no thread_id)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Hello — what can you help me with on this LAN agent?\"\n}"
            },
            "url": "{{baseUrl}}/api/chat"
          }
        }
      ]
    },
    {
      "name": "HITL",
      "item": [
        {
          "name": "Resume — Approve artifact",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.artifact_url) {",
                  "    pm.environment.set('artifactName', j.artifact_url.split('/').pop());",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
