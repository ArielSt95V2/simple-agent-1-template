# Copy to compose/.env and fill in secrets.

# --- Agent HTTP (LAN: bind host 0.0.0.0 via Docker port publish) ---
AGENT_PORT=8080
AGENT_PROFILE=document-chatbot

# --- OpenAI (default LLM via LangChain) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- LAN publish ---
AGENT_BIND=0.0.0.0
AGENT_PORT=8080

# --- Host bind mounts (paths relative to compose/ unless absolute) ---
INGEST_HOST_PATH=../data/ingest
WORKSPACE_HOST_PATH=../data/workspace

# In-container paths (leave default)
INGEST_PATH=/ingest
WORKSPACE_PATH=/workspace

# --- Sandbox tool limits (soft caps; no Docker CPU/mem limits yet) ---
SCRIPT_TIMEOUT_SECONDS=120
MAX_TOOL_OUTPUT_CHARS=12000
MAX_WRITE_BYTES=524288
MAX_READ_BYTES=524288

# LAN share ingest: set INGEST_HOST_PATH or use docker-compose.lan.example.yml

# --- Postgres (pgvector RAG + chat checkpoints) ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent
POSTGRES_URL=postgresql+psycopg://agent:change-me@postgres:5432/agent

# Chat checkpoints share this database (their own tables, separate from embeddings).
# CHECKPOINT_POOL_SIZE=10

# Optional: override profile config path
# CONFIG_YAML_PATH=/app/examples/document-chatbot/config.yaml
